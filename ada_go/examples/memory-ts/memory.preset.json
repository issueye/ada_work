{
  "name": "memory-ts",
  "plugins": [
    "../../plugins"
  ],
  "enable": [
    "agent-loop",
    "approval-gate",
    "compaction-basic",
    "fs-local",
    "llm-openai",
    "llm-replay",
    "memory-helper",
    "plan",
    "seam-approval",
    "seam-fs",
    "seam-llm",
    "seam-prompts",
    "seam-session",
    "seam-tools",
    "session-jsonl",
    "session-memory",
    "session-stats",
    "system-prompt",
    "tool-helper"
  ],
  "disable": [
    "llm-openai",
    "session-jsonl"
  ],
  "patch": {
    "agent-loop": {
      "model": "replay"
    },
    "approval-gate": {
      "timeoutMs": 20000,
      "tools": []
    },
    "compaction-basic": {
      "keepRecent": 8
    },
    "fs-local": {
      "workspace": "examples/memory-ts/workspace"
    },
    "llm-openai": {
      "apiKeyEnv": "ADA_LLM_API_KEY",
      "endpoint": "http://127.0.0.1:3050/v1",
      "maxTokens": 128,
      "model": "mosi/nex-n2.6"
    },
    "llm-replay": {
      "defaultModel": "replay",
      "models": [
        {
          "contextWindow": 8192,
          "id": "replay",
          "maxOutput": 1024
        }
      ],
      "path": "examples/memory-ts/replay.jsonl"
    },
    "memory-helper": {
      "autoRecall": true
    },
    "system-prompt": {
      "identity": "你是 ada 的最小测试 agent。",
      "rules": [
        "先读需要的文件,再总结。",
        "工具失败时如实说明。"
      ],
      "tools": "长期记忆:\n- 用户要求记住事实/偏好时调用 memory_write;\n- 回答涉及既往信息时先 memory_search 再引用;\n- 用户要求忘记时调用 memory_forget。\n"
    }
  }
}
