{
  "id": "workspace-local",
  "name": "workspace local",
  "version": "0.1.0",
  "kind": "go",
  "inject": {"required": ["workspace"]},
  "config": {
    "active": "repo",
    "workspaces": [
      {
        "id": "repo",
        "name": "示例仓库",
        "root": "examples/agent/workspace",
        "ignore": [".git", "bin", "dist"]
      },
      {
        "id": "docs",
        "name": "只读文档",
        "root": "examples/workspace/docs",
        "readOnly": true
      }
    ]
  }
}
