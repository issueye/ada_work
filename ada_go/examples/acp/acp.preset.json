{
  "name": "acp",
  "plugins": [
    "../../plugins"
  ],
  "enable": [
    "acp-helper",
    "agent-control",
    "agent-loop",
    "llm-replay",
    "plan",
    "seam-acp",
    "seam-approval",
    "seam-llm",
    "seam-prompts",
    "seam-session",
    "seam-tools",
    "session-memory",
    "tool-helper"
  ],
  "patch": {
    "agent-loop": {
      "model": "replay"
    },
    "llm-replay": {
      "defaultModel": "replay",
      "models": [
        {
          "contextWindow": 8192,
          "id": "replay",
          "maxOutput": 1024
        }
      ],
      "path": "examples/acp/replay.jsonl"
    }
  }
}
