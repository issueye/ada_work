# 复制为 .env 后按需填写;真实环境变量优先于本文件。
# 布尔/路径等值按 dotenv 语法书写(支持引号与 \n 转义),详见 docs/env-file.md。

# ——— 模型(OpenAI 兼容端点;留空走 preset 里的 replay)———
# ADA_LLM_API_KEY=sk-...
# ADA_LLM_ENDPOINT=https://api.deepseek.com
# ADA_LLM_MODEL=deepseek-chat

# ——— http_search 的 DeepSeek 网页搜索(还需启用 seam-secrets + secrets-env)———
# ADA_SECRET_DEEPSEEK_API_KEY=sk-...

# ——— ada-rpc-agent 的宿主契约(通常由 ada_chat 注入,手工调试时才用)———
# ADA_BOT_ADDR=pipe://ada-bot
# ADA_BOT_TOKEN=...
# ADA_GO_AGENT_PRESET=presets/agent-release.preset.json
